# ─────────────────────────────────────────────
# AgentOps Command Center — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/agentops

# ── LLM credentials (provide one of the two options below) ──────────────────

# Option A: standard OpenAI API key
# Without this (and without option B) the app runs in deterministic demo mode.
OPENAI_API_KEY=

# Option B: Replit-managed OpenAI integration
# Set automatically when you connect the Replit OpenAI integration.
# If both option A and B are present, option B takes priority.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Model configuration ───────────────────────────────────────────────────────

# Process-level model override (lowest priority — see model config precedence in replit.md).
# Options: gpt-4.1-mini (default), gpt-4.1, gpt-4.1-nano, o4-mini
# Operators can also set per-agent and global overrides via the Settings UI at runtime.
LLM_MODEL=gpt-4.1-mini

# LLM request timeout in milliseconds (default: 20000)
# LLM_REQUEST_TIMEOUT_MS=20000

# ── Python worker ─────────────────────────────────────────────────────────────

# URL for the agent worker service (default: http://127.0.0.1:8000)
# WORKER_BASE_URL=http://127.0.0.1:8000

# ── Twilio credentials (optional) ────────────────────────────────────────────
# Required only for SMS notifications and voice call features.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# ── Session / runtime ─────────────────────────────────────────────────────────

# Express session signing secret (optional for local dev)
SESSION_SECRET=change-me-in-production

# Node API port (default: 8080)
PORT=8080

# Runtime environment
NODE_ENV=development
