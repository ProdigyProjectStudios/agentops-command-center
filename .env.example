# ─────────────────────────────────────────────
# AgentOps Command Center — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/agentops

# OpenAI API key (optional)
# Without this the app runs in deterministic demo mode.
# Set to a valid key to enable live LLM calls.
OPENAI_API_KEY=

# LLM model override (optional)
# Overrides the default model set in the Settings UI.
# Options: gpt-4.1-mini, gpt-4.1, gpt-4.1-nano, o4-mini
LLM_MODEL=gpt-4.1-mini

# Twilio credentials (optional)
# Required only for SMS notifications and voice call features.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# Session signing secret (optional for local dev)
SESSION_SECRET=change-me-in-production

# Runtime (defaults shown)
PORT=8080
NODE_ENV=development
